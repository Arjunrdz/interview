class User
  @@users = []
  @@next_id = 1

  attr_reader :id
  attr_accessor :name, :email, :age

  def initialize(name, email, age)
    @id = @@next_id
    @@next_id += 1

    @name = name
    @email = email
    @age = age

    @@users << self
  end

  # Instance Methods

  def display
    puts "ID: #{@id}"
    puts "Name: #{@name}"
    puts "Email: #{@email}"
    puts "Age: #{@age}"
    puts "-" * 30
  end

  def update(name: nil, email: nil, age: nil)
    @name = name if name
    @email = email if email
    @age = age if age
  end

  # Class Methods

  def self.all_users
    if @@users.empty?
      puts "No users found."
    else
      @@users.each(&:display)
    end
  end

  def self.find_by_id(id)
    @@users.find { |user| user.id == id }
  end

  def self.find_by_email(email)
    @@users.find { |user| user.email == email }
  end

  def self.delete(id)
    user = find_by_id(id)
    if user
      @@users.delete(user)
      puts "User deleted successfully."
    else
      puts "User not found."
    end
  end

  def self.count
    @@users.length
  end
end

